{
  "opencollection": "1.0.0",
  "info": {
    "name": "Microsoft Dynamics 365 Business Central API v2.0 Companies API",
    "version": "v2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
