          },
          "docs": "List companies"
        },
        {
          "info": {
            "name": "Get a company",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.businesscentral.dynamics.com/v2.0/{environment}/api/v2.0/companies(:id)",
            "params": [
              {
                "name": "id",
                "value": "",
